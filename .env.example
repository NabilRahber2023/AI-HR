# Database
# Default: local SQLite file (zero-config, no Docker/Postgres needed).
DATABASE_URL=sqlite:///./hr_ai_platform.db
# To use PostgreSQL instead, comment the line above and use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hr_ai_platform
#
# PRODUCTION / VERCEL: SQLite will not persist on a serverless read-only
# filesystem, so set DATABASE_URL in the Vercel project's Environment Variables
# to a hosted Postgres connection string, e.g. (Neon/Supabase/Vercel Postgres):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# A "postgres://" scheme is accepted too (it is normalized automatically).

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama (local LLM for the chatbot & recommendation personalization)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Use any model you have pulled (e.g. phi3:mini, qwen2.5:7b, llama3:8b)
OLLAMA_MODEL=phi3:mini

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — must match the frontend origin (Next.js dev server defaults to 3000).
# In production set this to the deployed frontend URL, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
